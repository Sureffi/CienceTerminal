# API Gateway - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
API_GATEWAY_PORT=5149

# =============================================================================
# REQUIRED: Auth0 Configuration
# =============================================================================
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://your-api-audience

# =============================================================================
# Downstream Service URLs
# =============================================================================
# For local development (services running on different ports)
ALERT_SERVICE_URL=http://localhost:5148
TWITTER_SCANNER_URL=http://localhost:5147
TOKEN_METRICS_URL=http://localhost:5237
USER_MANAGEMENT_URL=http://localhost:5150

# For Docker deployment, these will be overridden in docker-compose.yml:
# ALERT_SERVICE_URL=http://alert-service:8080
# TWITTER_SCANNER_URL=http://twitter-scanner:8080

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ORIGIN_1=http://localhost:3000
CORS_ORIGIN_2=http://localhost:5173
CORS_ORIGIN_3=https://localhost:3000
CORS_ORIGIN_4=https://localhost:5173

# =============================================================================
# DEVELOPMENT FLAGS
# =============================================================================
ENABLE_SWAGGER=true
ENABLE_DETAILED_LOGGING=true
