{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiGateway": {
    "RequireAuthentication": false
  },
  "AlertServiceUrl": "http://localhost:5148",
  "TwitterScannerUrl": "http://localhost:5147",
  "ReverseProxy": {
    "Routes": {
      "block-internal-routes": {
        "ClusterId": "blocked",
        "Match": {
          "Path": "/internal/{**catch-all}"
        },
        "Order": 1
      },
      "v1-mentions-route": {
        "ClusterId": "alert-service",
        "Match": {
          "Path": "/api/v1/mentions/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/mentions/{**catch-all}"
          }
        ],
        "AuthorizationPolicy": "ApiPolicy",
        "Order": 1
      },
      "v1-alerts-ca-details-route": {
        "ClusterId": "twitter-scanner",
        "Match": {
          "Path": "/api/v1/alerts/ca-mentions/{address}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/ca-mentions/{address}"
          }
        ],
        "AuthorizationPolicy": "ApiPolicy",
        "Order": 2
      },
      "v1-alerts-route": {
        "ClusterId": "alert-service",
        "Match": {
          "Path": "/api/v1/alerts/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/alerts/{**catch-all}"
          }
        ],
        "AuthorizationPolicy": "ApiPolicy",
        "Order": 3
      },
      "v1-users-route": {
        "ClusterId": "user-management",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/users/{**catch-all}"
          }
        ],
        "AuthorizationPolicy": "ApiPolicy"
      },
      "twitter-alert-hub-route": {
        "ClusterId": "alert-service",
        "Match": {
          "Path": "/alerts/hub/twitter/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/twitter-alert-hub/{**catch-all}"
          }
        ],
        "AuthorizationPolicy": "ApiPolicy"
      },
      "ca-mention-alert-hub-route": {
        "ClusterId": "alert-service",
        "Match": {
          "Path": "/alerts/hub/ca-mentions/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/ca-mention-alert-hub/{**catch-all}"
          }
        ],
        "AuthorizationPolicy": "ApiPolicy"
      }
    },
    "Clusters": {
      "blocked": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:1"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": false
          }
        }
      },
      "twitter-scanner": {
        "Destinations": {
          "destination1": {
            "Address": "http://twitter-scanner:8080"
          }
        }
      },
      "alert-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://alert-service:8080"
          }
        }
      },
      "user-management": {
        "Destinations": {
          "destination1": {
            "Address": "http://user-management:8080"
          }
        }
      }
    }
  }
}
