# Alert Service - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
ALERT_SERVICE_PORT=5148

# =============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# =============================================================================
ConnectionStrings__AlertServiceDb=Host=localhost;Port=5432;Database=cienceterminal;Username=postgres;Password=your-password
ConnectionStrings__CienceTerminalDb=Host=localhost;Port=5432;Database=cienceterminal;Username=postgres;Password=your-password

# =============================================================================
# AWS CONFIGURATION (LocalStack for Development)
# =============================================================================
AWS__UseLocalStack=true
AWS__LocalStackUrl=http://localhost:4566
AWS__Region=us-east-1

# SQS Queues (Consumer)
AWS__SQS__TwitterAlertsQueueUrl=http://localhost:4566/000000000000/alert-service-twitter-alerts-queue
AWS__SQS__MentionAggregatesUpdatedQueueUrl=http://localhost:4566/000000000000/alert-service-mention-aggregates-updated-queue
AWS__SQS__AlertRemovalQueueUrl=http://localhost:4566/000000000000/alert-service-alert-removal-queue
AWS__SQS__CoinBlacklistedQueueUrl=http://localhost:4566/000000000000/alert-service-coin-blacklisted-queue
AWS__SQS__TokenMetricsUpdatedQueueUrl=http://localhost:4566/000000000000/alert-service-token-metrics-updated-queue

# SNS Topics (Publisher)
AWS__SNS__AlertRemovalTopicArn=arn:aws:sns:us-east-1:000000000000:cienceterminal-alert-removal

# AWS SDK Credentials for LocalStack
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# =============================================================================
# AUTH0 CONFIGURATION (REQUIRED)
# =============================================================================
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://your-api-audience

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ORIGIN_1=http://localhost:3000
CORS_ORIGIN_2=http://localhost:5173
CORS_ORIGIN_3=https://localhost:3000
CORS_ORIGIN_4=https://localhost:5173

# =============================================================================
# ALERT OPTIONS
# =============================================================================
AlertOptions__MaxAlertsPerUser=100
AlertOptions__AlertExpiryMinutes=60

# =============================================================================
# DEVELOPMENT FLAGS
# =============================================================================
ENABLE_SWAGGER=true
ENABLE_DETAILED_LOGGING=true
