# Token Metrics Service - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
TOKEN_METRICS_PORT=5237

# =============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# =============================================================================
ConnectionStrings__TokenMetricsDb=Host=localhost;Port=5432;Database=cienceterminal;Username=postgres;Password=your-password

# =============================================================================
# API KEYS (REQUIRED)
# =============================================================================
ApiKeys__Helius=your-helius-api-key-here

# =============================================================================
# API ENDPOINTS
# =============================================================================
Endpoints__Helius=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE

# =============================================================================
# AWS CONFIGURATION (LocalStack for Development)
# =============================================================================
AWS__UseLocalStack=true
AWS__LocalStackUrl=http://localhost:4566
AWS__Region=us-east-1

# SQS Queues (Consumer)
AWS__SQS__CaMentionDetectedQueueUrl=http://localhost:4566/000000000000/token-metrics-service-ca-mention-detected-queue

# SNS Topics (Publisher)
AWS__SNS__MentionAggregatesUpdatedTopicArn=arn:aws:sns:us-east-1:000000000000:cienceterminal-mention-aggregates-updated
AWS__SNS__TokenMetricsUpdatedTopicArn=arn:aws:sns:us-east-1:000000000000:cienceterminal-token-metrics-updated
AWS__SNS__CoinBlacklistedTopicArn=arn:aws:sns:us-east-1:000000000000:cienceterminal-coin-blacklisted

# AWS SDK Credentials for LocalStack
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# =============================================================================
# DEVELOPMENT FLAGS
# =============================================================================
ENABLE_SWAGGER=true
ENABLE_DETAILED_LOGGING=true
