# Twitter Scanner Service - Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# REQUIRED: API Keys
# =============================================================================
ApiKeys__Groq=your_groq_api_key
ApiKeys__Twitter=your_twitter_api_key
ApiKeys__Helius=your_helius_api_key

# =============================================================================
# REQUIRED: API Endpoints
# =============================================================================
Endpoints__Twitter=wss://ws.twitterapi.io/twitter/tweet/websocket
Endpoints__Groq=https://api.groq.com/openai/v1/chat/completions
Endpoints__Helius=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key

# =============================================================================
# AWS SDK Credentials
# =============================================================================
# For LocalStack (development)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# For Production AWS, use actual credentials:
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_DEFAULT_REGION=eu-central-1

# =============================================================================
# Environment
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development
