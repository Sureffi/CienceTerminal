# =============================================================================
# CienceTerminal Frontend Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Demo Mode Configuration
# -----------------------------------------------------------------------------
# Set to 'true' to enable demo mode with mock data (no backend or authentication required)
# Set to 'false' (or remove) for production mode with real backend and Auth0
VITE_DEMO_MODE=true

# -----------------------------------------------------------------------------
# Auth0 Configuration (Only needed when VITE_DEMO_MODE=false)
# -----------------------------------------------------------------------------
VITE_AUTH0_DOMAIN=your-auth0-domain.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-client-id
VITE_AUTH0_AUDIENCE=https://cienceterminal-api

# -----------------------------------------------------------------------------
# API Gateway URL (Only needed when VITE_DEMO_MODE=false)
# -----------------------------------------------------------------------------
# For local development, use the API Gateway running locally
VITE_API_GATEWAY_URL=http://localhost:5149

# For production deployment, leave empty to use relative paths
# VITE_API_GATEWAY_URL=
