# Frontend - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# Demo Mode Configuration
# =============================================================================
# Set to 'true' to enable demo mode with mock data (no backend or authentication required)
# Set to 'false' (or remove) for production mode with real backend and Auth0
VITE_DEMO_MODE=true

# =============================================================================
# Auth0 Frontend Configuration (REQUIRED when VITE_DEMO_MODE=false)
# =============================================================================
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id-here
VITE_AUTH0_AUDIENCE=https-your-api-audience

# =============================================================================
# API URLs (REQUIRED when VITE_DEMO_MODE=false)
# =============================================================================
VITE_API_BASE_URL=http://localhost:5148
VITE_USER_MANAGEMENT_URL=http://localhost:5150

# For production deployment:
# VITE_API_GATEWAY_URL=http://localhost:5149

# =============================================================================
# Supabase (Optional - if still needed)
# =============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
