# =============================================================================
# CienceTerminal - Environment Variables Template
# =============================================================================
# This is a consolidated template for ALL services in development mode
# For production, use individual .env.example files in each service directory
#
# Copy this file to .env and fill in the required values
#
# Service-specific examples:
# - services/twitter-scanner/.env.example
# - services/alert-service/.env.example
# - services/api-gateway/.env.example
# - frontend/.env.example
# =============================================================================

# =============================================================================
# API KEYS (Required for functionality)
# =============================================================================
ApiKeys__Groq=your_groq_api_key_here
ApiKeys__Twitter=your_twitter_api_key_here
ApiKeys__Helius=your_helius_api_key_here

# =============================================================================
# API ENDPOINTS
# =============================================================================
Endpoints__Twitter=wss://ws.twitterapi.io/twitter/tweet/websocket
Endpoints__Groq=https://api.groq.com/openai/v1/chat/completions
Endpoints__Helius=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here

# =============================================================================
# AWS CONFIGURATION (LocalStack for Development)
# =============================================================================
AWS__UseLocalStack=true
AWS__LocalStackUrl=http://localhost:4566
AWS__Region=us-east-1
AWS__SNS__TwitterAlertsTopicArn=arn:aws:sns:us-east-1:000000000000:cienceterminal-twitter-alerts
AWS__SNS__CaMentionAlertsTopicArn=arn:aws:sns:us-east-1:000000000000:cienceterminal-ca-mention-alerts
AWS__SNS__AlertRemovalTopicArn=arn:aws:sns:us-east-1:000000000000:cienceterminal-alert-removal
AWS__SQS__TwitterAlertsQueueUrl=http://localhost:4566/000000000000/alert-service-twitter-alerts-queue
AWS__SQS__CaMentionAlertsQueueUrl=http://localhost:4566/000000000000/alert-service-ca-mention-alerts-queue
AWS__SQS__AlertRemovalQueueUrl=http://localhost:4566/000000000000/alert-service-alert-removal-queue

# AWS SDK Credentials for LocalStack
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# =============================================================================
# AUTH0 CONFIGURATION
# =============================================================================
# Backend Auth0 Configuration
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://your-api-audience

# =============================================================================
# SERVICE PORTS
# =============================================================================
API_GATEWAY_PORT=5149
TWITTER_SCANNER_PORT=5147
ALERT_SERVICE_PORT=5148
USER_MANAGEMENT_PORT=5150
FRONTEND_PORT=3000

# =============================================================================
# ASPNET CORE SETTINGS
# =============================================================================
ASPNETCORE_ENVIRONMENT=Development

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ORIGIN_1=http://localhost:3000
CORS_ORIGIN_2=http://localhost:5173
CORS_ORIGIN_3=https://localhost:3000
CORS_ORIGIN_4=https://localhost:5173

# =============================================================================
# FRONTEND CONFIGURATION (React/Vite)
# =============================================================================
# Auth0 Frontend Configuration
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_auth0_client_id
VITE_AUTH0_AUDIENCE=https://your-api-audience

# API URLs
VITE_API_GATEWAY_URL=http://localhost:5149
VITE_API_BASE_URL=http://localhost:5148
VITE_USER_MANAGEMENT_URL=http://localhost:5150

# Demo Mode (disable authentication/backend)
VITE_DEMO_MODE=false

# =============================================================================
# DEVELOPMENT FLAGS
# =============================================================================
ENABLE_SWAGGER=true
ENABLE_DETAILED_LOGGING=true

# =============================================================================
# PRODUCTION DEPLOYMENT NOTES
# =============================================================================
# For production deployment, DO NOT use this consolidated file.
# Instead, use service-specific .env.example files:
#
# 1. Twitter Scanner Service: services/twitter-scanner/.env.example
#    Required: Groq API, Twitter API, Helius API, AWS SNS
#
# 2. Alert Service: services/alert-service/.env.example
#    Required: AWS SQS queues
#
# 3. API Gateway: services/api-gateway/.env.example
#    Required: Auth0 configuration
#
# 4. Frontend: frontend/.env.example
#    Required: Auth0 configuration, API Gateway URL
#
# Each service should have its own environment variables configured
# based on its specific requirements and deployment target.
